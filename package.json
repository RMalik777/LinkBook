		"@lucide/svelte": "^0.577.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@typescript-eslint/parser": "^8.70.0",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
