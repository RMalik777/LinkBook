		"shadcn-svelte": "^1.7.0",
		"simple-icons": "^16.32.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "4.3.3",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
